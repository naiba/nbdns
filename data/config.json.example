{
    "$schema": "./config.schema.json",
    "debug": false,
    "profiling": false,
    "timeout": 2,
    "serve_addr": "127.0.0.1:8853",
    "web_addr": "0.0.0.0:8854",
    "socks_proxy": "",
    "built_in_cache": false,
    "max_active_connections": 50,
    "max_idle_connections": 20,
    "stats_save_interval": 5,
    "doh_server": {
        "username": "user",
        "password": "password"
    },
    "bootstrap": [
        {
            "address": "tcp-tls://8.8.8.8:853",
            "ecs": ""
        }
    ],
    "upstreams": [
        {
            "address": "https://dns.google/dns-query",
            "proxy_enabled": false
        }
    ],
    "filter_lists": [],
    "filter_update_interval_hours": 24,
    "ecs": "180.152.0.0/24",
    "custom_records": []
}
